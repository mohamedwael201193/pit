# WHAT: dual-network public config for PIT
# WHY: operators and judges need addresses without secrets
# ENVIRONMENT: A global / D testnet / E mainnet / F optional
# SECRET: every value here is no unless marked

# A. GLOBAL
# WHAT: product network selector
PIT_NETWORK=mainnet
# SECRET? no

PIT_ALLOW_FALLBACKS=false
# SECRET? no — process must exit if this is not false

# E. MAINNET (Aristotle 16661)
PIT_CHAIN_RPC_URL=https://evmrpc.0g.ai
PIT_CHAIN_ID=16661
PIT_EXPLORER_BASE=https://chainscan.0g.ai
PIT_ROUTER_URL=https://router-api.0g.ai
PIT_SERVING_CONTRACT=0x47340d900bdFec2BD393c626E12ea0656F938d84
PIT_LEDGER_CONTRACT=0x2dE54c845Cd948B72D2e32e39586fe89607074E3
PIT_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
PIT_STORAGE_FLOW=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526
PIT_8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
PIT_8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
PIT_DESK_ID_CONTRACT=0xfdB3a8D39F1E2b77a8261b359eABaaa2F08f8c35
PIT_RECEIPTS_CONTRACT=
PIT_FORECASTS_CONTRACT=
PIT_MEMORY_CONTRACT=
PIT_HL_INFO_URL=https://api.hyperliquid.xyz/info
PIT_HL_EXCHANGE_URL=https://api.hyperliquid.xyz/exchange

# D. TESTNET (Galileo 16602)
PIT_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai
PIT_TESTNET_CHAIN_ID=16602
PIT_TESTNET_EXPLORER=https://chainscan-galileo.0g.ai
PIT_TESTNET_ROUTER_URL=https://router-api-testnet.integratenetwork.work
PIT_TESTNET_SERVING_CONTRACT=0xa79F4c8311FF93C06b8CfB403690cc987c93F91E
PIT_TESTNET_LEDGER_CONTRACT=0xE70830508dAc0A97e6c087c75f402f9Be669E406
PIT_TESTNET_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
PIT_TESTNET_STORAGE_FLOW=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296
PIT_TESTNET_8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
PIT_TESTNET_8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
PIT_TESTNET_DESK_ID_CONTRACT=
PIT_TESTNET_RECEIPTS_CONTRACT=
PIT_TESTNET_FORECASTS_CONTRACT=
PIT_TESTNET_MEMORY_CONTRACT=
PIT_HL_TESTNET_INFO=https://api.hyperliquid-testnet.xyz/info
PIT_HL_TESTNET_EXCHANGE=https://api.hyperliquid-testnet.xyz/exchange

# F. OPTIONAL — wallet connect (public app id only)
# WHAT: Privy application identifier for web/desktop connect
# WHY: SIWE / wallet UX. Not a private key. Not a Hyperliquid session.
# SECRET? no
PIT_PRIVY_APP_ID=cmtafcijw02av0cl1ay81om7m
NEXT_PUBLIC_PRIVY_APP_ID=cmtafcijw02av0cl1ay81om7m
VITE_PRIVY_APP_ID=cmtafcijw02av0cl1ay81om7m

# WHAT: Privy app secret — server-side verification only
# SECRET? yes — never ship to the browser, never commit
PIT_PRIVY_APP_SECRET=

# B. USER-SCOPED — never set on a server
# PIT_MASTER_ADDRESS=
# PIT_MEMORY_KEY=
# Hyperliquid session keys belong in the OS keychain.

# F. OPTIONAL — public health origin for Watch (no session)
# SECRET? no
VITE_HEALTH_URL=https://pit-health.onrender.com

# WHAT: secret backend. os = Windows Credential Manager / macOS Keychain / libsecret. file = local 0600 store for tests.
# SECRET? no (selector only)
PIT_KEYRING=os

# WHAT: companion bind. Must be loopback. Default 127.0.0.1:17373
# SECRET? no
PIT_COMPANION_ADDR=127.0.0.1:17373

# Direct TeeML sealer (native Go binary built from ./sealer). Never a Router URL.
# SECRET? no (path only). Empty is allowed if sealer/pit-sealer exists next to the working directory.
PIT_COMMITTEE_BIN=

# Path to Direct auth JSON (provider URL, TeeML, wallet-signed app-sk- token).
# Never a Router dashboard sk-/mk- key. Never commit the file.
# SECRET? yes
PIT_DIRECT_AUTH_FILE=

# Official Go storage client path. Never a TypeScript SDK.
# SECRET? no (path only)
PIT_STORAGE_CLI=

# Test-only. When 1, go test runs a live Aristotle turbo upload/download --proof.
# SECRET? no (switch only). Uses PIT_OG_PAYER_KEY for gas and a generated AES key.
# PIT_LIVE_STORAGE=

# Local CLI state lives on this machine (policy pin, preview, ledger). Never a cloud database URL.
# SECRET? no

# C. FIXTURES — local gate only, not the product user
# PIT_OG_PAYER_KEY=
# PIT_DEPLOYER_KEY=
