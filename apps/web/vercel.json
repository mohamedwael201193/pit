{
  "rewrites": [
    { "source": "/.well-known/agent-card.json", "destination": "/.well-known/agent-card.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/windows",
      "destination": "https://pit-health.onrender.com/windows",
      "permanent": false
    },
    {
      "source": "/checksums",
      "destination": "https://pit-health.onrender.com/checksums",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}

