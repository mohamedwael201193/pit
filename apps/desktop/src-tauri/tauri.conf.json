{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIT",
  "identifier": "os.pit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001"
  },
  "app": {
    "windows": [
      {
        "title": "PIT",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  }
}
