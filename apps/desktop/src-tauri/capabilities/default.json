{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "PIT desktop window. Session secrets stay in the OS keychain, never in the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-companion-url",
    "allow-export-session",
    "allow-local-status",
    "allow-local-code",
    "allow-local-doctor",
    "allow-ensure-companion",
    "allow-local-init",
    "allow-local-session",
    "allow-local-policy",
    "allow-local-revoke-session",
    "allow-local-direct-intent",
    "allow-local-direct-status",
    "allow-local-research",
    "allow-local-research-start",
    "allow-local-research-status",
    "allow-local-research-cancel"
  ]
}
