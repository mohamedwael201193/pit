{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "PIT desktop window. Session secrets stay in the OS keychain, never in the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-companion-url",
    "allow-export-session",
    "allow-local-status",
    "allow-local-code",
    "allow-local-doctor",
    "allow-ensure-companion",
    "allow-local-init",
    "allow-local-session",
    "allow-local-connection-preview",
    "allow-local-policy",
    "allow-local-revoke-session",
    "allow-local-direct-intent",
    "allow-local-direct-status",
    "allow-local-research",
    "allow-local-research-start",
    "allow-local-research-status",
    "allow-local-research-result",
    "allow-local-research-cancel",
    "allow-local-authorize",
    "allow-local-cancel-order",
    "allow-local-watch",
    "allow-local-kill",
    "allow-local-activity",
    "allow-local-positions",
    "allow-local-chat",
    "allow-local-chat-log",
    "allow-local-memory-forget",
    "allow-local-calibration",
    "allow-local-security",
    "allow-local-identity",
    "allow-local-update",
    "allow-local-explain",
    "allow-local-models"
  ]
